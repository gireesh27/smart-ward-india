# ─────────────────────────────────────────────────────────────────────────────
# Smart Ward India — environment variables
# Copy to .env and adjust. Values marked LOCAL match docker-compose.yml and must
# NOT be used in production.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used for auth callbacks, emails and
# the CSRF origin check.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (LOCAL)
DATABASE_URL=postgresql://smartward:smartward_local_only@localhost:5432/smartward?schema=public
# Optional: separate DB used by `npm run test:integration` (created automatically by docker compose)
TEST_DATABASE_URL=postgresql://smartward:smartward_local_only@localhost:5432/smartward_test?schema=public

# Authentication — REQUIRED. Generate a 32+ byte random value:
#   macOS/Linux:        openssl rand -base64 32
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# File storage. "local" keeps uploads in UPLOAD_DIR (default, no extra services).
# "s3" uses an S3-compatible store: for local MinIO run `docker compose --profile s3 up -d`.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads

# Only used when STORAGE_DRIVER=s3 (values below match the optional local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smartward-uploads
S3_ACCESS_KEY_ID=smartward
S3_SECRET_ACCESS_KEY=smartward_local_only
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# Email. "smtp" = send via SMTP (local Mailpit inbox at http://localhost:8025).
# "console" = print emails, including verification/reset links, in the `npm run dev` terminal.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Smart Ward India <no-reply@smartward.test>"

# Upload limits
UPLOAD_MAX_BYTES=5242880
# Videos (MP4, WebM, MOV) may be larger. Raise your reverse proxy body limit to match in production.
UPLOAD_MAX_VIDEO_BYTES=52428800
UPLOAD_MAX_FILES=6

# Folder with converted LGD data (npm run lgd:convert writes here)
LGD_DATA_DIR=data/lgd/andhra-pradesh

# Map tiles (OpenStreetMap's public tiles are for light/demo use only; use a
# commercial or self-hosted tile server in production and update attribution).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# ── AI insights (optional; see docs/AI.md) ─────────────────────────────────
# The platform is fully functional with AI_PROVIDER=none. Only aggregated,
# non-personal statistics are ever sent to a model.
#   ollama    – free, runs locally:  docker compose --profile ai up -d  then
#               docker compose exec ollama ollama pull llama3.1:8b
#   openai    – OpenAI or any OpenAI-compatible server (set AI_BASE_URL)
#   anthropic – Claude models
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_MS=120000

