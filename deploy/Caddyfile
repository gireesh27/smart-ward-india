# Automatic HTTPS (Let's Encrypt) for your domain. Point an A record at the server first.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Large uploads (videos) are limited by the app (UPLOAD_MAX_VIDEO_BYTES); allow them through.
	request_body {
		max_size 60MB
	}
}
