# Copy to deploy/.env.production and fill in. Never commit the real file.
DOMAIN=smartward.example.in
APP_IMAGE=ghcr.io/your-github-user/smart-ward-india:latest
TOOLS_IMAGE=ghcr.io/your-github-user/smart-ward-india:latest-tools
# If Docker Hub is blocked on your network, use a mirror, e.g.:
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2-alpine

POSTGRES_DB=smartward
POSTGRES_USER=smartward
POSTGRES_PASSWORD=change-me-to-a-long-random-password

NODE_ENV=production
APP_URL=https://smartward.example.in
NEXT_PUBLIC_APP_URL=https://smartward.example.in
DATABASE_URL=postgresql://smartward:change-me-to-a-long-random-password@postgres:5432/smartward
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-48
BETTER_AUTH_URL=https://smartward.example.in

# Files: local disk inside the "uploads" volume, or S3-compatible storage (R2 / S3 / Blob via S3 API)
STORAGE_DRIVER=local
UPLOAD_DIR=/app/storage/uploads

# Email (choose a transactional SMTP provider: Brevo, Resend, Amazon SES, Azure Communication Services…)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Smart Ward India <no-reply@smartward.example.in>"

# Optional AI insights (docs/AI.md)
AI_PROVIDER=none
