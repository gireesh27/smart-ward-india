{
  "name": "smart-ward-india",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Ward India \u2014 Panchayat & Municipality Development Platform (independent demonstration platform)",
  "engines": {
    "node": ">=20.12 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "verify:domain": "tsx --test scripts/verify-domain.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "scores:recompute": "tsx --env-file=.env scripts/recompute-scores.ts",
    "insights:refresh": "tsx --env-file=.env scripts/refresh-insights.ts",
    "uploads:cleanup": "tsx --env-file=.env scripts/cleanup-uploads.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "lgd:convert": "node scripts/lgd/convert.mjs --in data/lgd/raw --out data/lgd/andhra-pradesh",
    "lgd:import": "tsx --env-file=.env scripts/lgd/import.ts",
    "geo:prepare": "tsx scripts/geo/prepare-boundaries.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@phosphor-icons/react": "^2.1.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.3",
    "better-auth": "~1.2.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "framer-motion": "^11.11.1",
    "leaflet": "^1.9.4",
    "next": "^14.2.25",
    "nodemailer": "^6.9.15",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.2",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.25",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.1"
  }
}
